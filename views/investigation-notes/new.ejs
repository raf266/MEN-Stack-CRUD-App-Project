<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Investigation Notes</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("../partials/navbar") %>
    <%- include("../partials/toast") %>

    <main class="investigation-page form-background">
        <section class="investigation-container">
            <h1>Add Investigation Note</h1>

            <p>Incident: <%= incident.title %></p>

            <form action="/incidents/<%= incident._id %>/notes" method="POST">

                <label for="content">Investigation Note:</label>

                <textarea name="content" id="content" rows="6" required></textarea>

                <button type="submit" class="investigation-btn"> Add Note</button>

            </form>

            <a href="/incidents/<%= incident._id %>" class="investigation-cancel-btn">Cancel</a>
        </section>
    </main>
    
</body>
</html>