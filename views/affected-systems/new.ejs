<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Add Affected System</h1>
    <p>Incident: <%= incident.title %></p>
    <form action="/incidents/<%= incident._id %>/systems" method="POST">
        <label for="hostname">Hostname:</label>
        <input type="text" name="hostname" id="hostname" required>

        <label for="ipAddress">IP Address:</label>
        <input type="text" name="ipAddress" id="ipAddress" required>

        <label for="operatingSystem">Operating System:</label>
        <input type="text" name="operatingSystem" id="operatingSystem" required>

        <button type="submit">Add System</button>
    </form>

    <a href="/incidents/<%= incident._id %>">Cancel</a>

</body>
</html>