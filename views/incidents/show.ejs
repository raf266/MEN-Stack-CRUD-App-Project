<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Incident Details</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <%- include("../partials/navbar") %>
    <%- include("../partials/toast") %>

  <main class="details-page">
            <section class="incident-details">
                <div class="details-header">
                    <div>
                        <p class="details-label">INCIDENT DETAILS</p>
                        <h1><%= incident.title %></h1>
                    </div>
                    <% if ( user && incident.createdBy.toString()===user._id.toString() ) { %>
                        <a href="/incidents/<%= incident._id %>/edit" class="edit-incident-btn">Edit Incident</a>
                        <% } %>
                </div>


                <p class="details-description"><%= incident.description %></p>

                <div class="incident-summary">
                    <p>Severity: <span class="severity <%= incident.severity.toLowerCase() %>"><%= incident.severity %></span></p>
                    <p>Status: <span class="status <%= incident.status.toLowerCase() %>"><%= incident.status %></span></p>
                    <p>Created: <span><%= incident.createdAt.toLocaleDateString() %></span></p>

                </div>
            </section>

        <section class="details-section">
            <div class="section-header">
                <h2>Affected Systems</h2>
                <% if (user && incident.createdBy.toString() === user._id.toString()) { %>
                    <a href="/incidents/<%= incident._id %>/systems/new" class="add-btn">+ Add System</a>
                <% } %>
            </div>

            <% if (affectedSystems.length === 0) { %>
                <p class="empty-message">No affected systems added.</p>
            <% } else { %>
                <% affectedSystems.forEach((system) => { %>
                    <div class="system-card">
                        <div>
                            <p class="system-label">Hostname</p>
                            <p><%= system.hostname %></p>
                        </div>

                        <div>
                            <p class="system-label">IP Address</p>
                            <p><%= system.ipAddress %></p>
                        </div>

                        <div>
                            <p class="system-label">Operating System</p>
                            <p><%= system.operatingSystem %></p>
                        </div>

                        <% if (user && incident.createdBy.toString() === user._id.toString()) { %>
                            <div class="system-actions">
                                <a href="/incidents/<%= incident._id %>/systems/<%= system._id %>/edit">Edit</a>

                                <form action="/incidents/<%= incident._id %>/systems/<%= system._id %>?_method=DELETE" method="POST">
                                    <button type="submit">Delete</button>
                                </form>
                            </div>
                        <% } %>
                    </div>
                <% }) %>
            <% } %>
        </section>

        <section class="details-section">
            <div class="section-header">
                <h2>Investigation Notes</h2>
                <% if (user && incident.createdBy.toString() === user._id.toString()) { %>
                    <a href="/incidents/<%= incident._id %>/notes/new" class="add-btn">+ Add Note</a>
                <% } %>
            </div>

            <% if (investigationNotes.length === 0) { %>
                <p class="empty-message">No investigation notes added.</p>
            <% } else { %>
                <% investigationNotes.forEach((note) => { %>
                    <div class="note-card">
                        <p class="note-content"><%= note.content %></p>

                        <% if (note.author) { %>
                            <p class="note-details">
                                <%= note.author.username %> • <%= note.createdAt.toLocaleString() %>
                            </p>
                        <% } %>
                    </div>
                <% }) %>
            <% } %>
        </section>

        <div class="details-footer">
            <a href="/incidents" class="back-btn">← Back to Incidents</a>

            <% if (user && incident.createdBy.toString() === user._id.toString()) { %>
                <form action="/incidents/<%= incident._id %>?_method=DELETE" method="POST">
                    <button type="submit" class="delete-incident-btn">Delete Incident</button>
                </form>
            <% } %>
        </div>
  </main>
</body>
</html>